{
  "cases": [
    {
      "name": "empty input lands at left padding",
      "input": {
        "element_frame": {"x": 100, "y": 200, "w": 400, "h": 40},
        "cursor_text_width": 0
      },
      "expected_caret": {"x": 112, "y": 211, "w": 0, "h": 18}
    },
    {
      "name": "cursor follows measured text",
      "input": {
        "element_frame": {"x": 100, "y": 200, "w": 400, "h": 40},
        "cursor_text_width": 80
      },
      "expected_caret": {"x": 192, "y": 211, "w": 0, "h": 18}
    },
    {
      "name": "cursor clamps to right inset when text overflows",
      "input": {
        "element_frame": {"x": 100, "y": 200, "w": 200, "h": 40},
        "cursor_text_width": 500
      },
      "expected_caret": {"x": 292, "y": 211, "w": 0, "h": 18}
    },
    {
      "name": "tall element centers caret vertically",
      "input": {
        "element_frame": {"x": 0, "y": 0, "w": 400, "h": 100},
        "cursor_text_width": 0
      },
      "expected_caret": {"x": 12, "y": 41, "w": 0, "h": 18}
    }
  ]
}
